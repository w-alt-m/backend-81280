<h1 class="mb-4">Carrito de Compras</h1>

{{#if cart.products.length}}
<div class="card">
    <div class="card-body">
        <ul class="list-group list-group-flush">
            {{#each cart.products}}
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">{{this.product.title}}</h5>
                    <small class="text-muted">Precio unitario: ${{this.product.price}}</small>
                </div>
                <span class="badge bg-primary rounded-pill">Cantidad: {{this.quantity}}</span>
            </li>
            {{/each}}
        </ul>
    </div>
</div>
{{else}}
<div class="alert alert-info">El carrito está vacío.</div>
{{/if}}

<a href="/products" class="btn btn-outline-secondary mt-3">Volver a productos</a>